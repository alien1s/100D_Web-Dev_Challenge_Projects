<%- include('../../shared/includes/head',{pageTitle: 'All Proudcts'}) %>
    <link
      rel="stylesheet"
      href="/styles/cart.css"
    />
</head>
<body>
    <%- include('../../shared/includes/header') %>
    <main>
        <h1>Proudcts</h1>
        <ul id="cart-items">
               <% for(const cartItem of locals.cart.items) {%> 
                    <li>
                        <%- include('includes/cart-item', {item: cartItem}) %>
                    </li>
                <% } %>
        </ul>
        <div id="cart-total">
            <h2>Total:</h2>
            <p><span class="cart-product-price">Items:</span> <%= locals.cart.totalQuantity %></p>
            <p><span class="cart-product-price">Price:</span> <%= locals.cart.totalPrice.toFixed(2) %></p>
            <button class="btn">Buy Product</button>
        </div>
    </main>

<%- include('../../shared/includes/footer') %>   