<%- include('../../shared/includes/head',{pageTitle: 'Add New Proudcts'}) %>
    <link
      rel="stylesheet"
      href="/styles/form.css"
    />
</head>
<body>
    <%- include('../../shared/includes/header') %>
    <main>
        
        <h1>Creating New Product</h1>
        <form action="/admin/products?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
            <p>
                <label for="email">Title</label>
                <input type="text" id="title" name= "title" value="<%= %>" required>

            </p>
            <p>
                <label for="image">Image</label>
                <input type="file" id="image" name="image" accept="image/png, image/jpg" value="<%= %>" required>
            </p>
            <p>
                <label for="summary">Summary</label>
                <input type="text" id="summary" name="summary" value="<%= %>" required maxlength="250">

            </p>
            <p>
                <label for="price">Price</label>
                <input type="number" id="price" name="price" value="<%= %>" required min="0.01" step="0.01">
            </p>
            <p>
                <label for="description">Description</label>
                <textarea id="description" name="description" value="<%= %>" required rows="10"></textarea>
            </p>
            <button type="reset" class="btn btn-alt">Rest</button>
            <button class="btn">Save</button>
        </form>

    </main>

<%- include('../../shared/includes/footer') %>  