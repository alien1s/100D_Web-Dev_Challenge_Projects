<article class="product-item">
  <img
    src="<%= product.imageUrl %>"
    alt="<%= product.title %>"
  />
  <div class="product-item-content">
    <h3><%= product.title %></h3>
    <div class="product-item-actions">
      <% if (isAdmin) { %>
        <a
          class="btn btn-alt"
          href="/admin/products/<%= product.id %>"
        >
          View&Edit
        </a>
        <button
          class="btn"
          data-productid="<%= product.id %>"
          data-csrf="<%= csrfToken %>"
        >
          Delete
        </button>
      <% } else {%>
        <a
          class="btn btn-alt"
          href="/products/<%= product.id %>"
        >
          View Details
        </a>
      <% } %>
    </div>
  </div>
</article>
